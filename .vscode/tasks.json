{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run app",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m perpustakaan",
      "options": { "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "problemMatcher": []
    },
    {
      "label": "Tests",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pytest tests/ -q",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lint (ruff)",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m ruff check src/ tests/",
      "problemMatcher": []
    },
    {
      "label": "Build EXE (Windows)",
      "type": "shell",
      "command": "build.bat",
      "windows": { "command": "build.bat" },
      "problemMatcher": []
    }
  ]
}
